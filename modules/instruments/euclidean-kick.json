{
  "id": "euclidean-kick",
  "name": "Euclidean Kick",
  "author": "strudelrack",
  "version": "1.0.0",
  "type": "instrument",
  "tags": ["kick", "drums", "percussive", "euclidean"],
  "description": "Euclidean rhythm kick drum. Distributes pulses evenly across steps.",
  "strudelCode": "s(\"bd\").euclid({{pulses}},{{steps}}).gain({{gain}}).decay({{decay}}).room({{room}})",
  "params": [
    { "id": "pulses", "label": "Pulses", "type": "knob", "min": 1, "max": 16, "step": 1, "default": 3, "showInNodeView": true },
    { "id": "steps", "label": "Steps", "type": "knob", "min": 1, "max": 16, "step": 1, "default": 8, "showInNodeView": true },
    { "id": "gain", "label": "Gain", "type": "knob", "min": 0, "max": 1.5, "default": 0.9, "showInNodeView": true },
    { "id": "decay", "label": "Decay", "type": "knob", "min": 0.05, "max": 1, "default": 0.3, "unit": "s" },
    { "id": "room", "label": "Room", "type": "knob", "min": 0, "max": 1, "default": 0.1 }
  ],
  "visual": {
    "panelColor": "#1a1200",
    "accentColor": "#ffb347",
    "knobStyle": "aluminum",
    "panelTexture": "brushed-metal",
    "hasOscilloscope": false,
    "hasVuMeter": true,
    "panelWidthHP": 8
  },
  "ports": {
    "inputs": [{ "id": "trig", "label": "Trig", "type": "trigger" }],
    "outputs": [{ "id": "out", "label": "Out", "type": "audio" }]
  },
  "createdAt": "2026-05-30T00:00:00Z"
}
